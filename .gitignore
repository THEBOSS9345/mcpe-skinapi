# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and coverage
*.test
*.out
coverage.*
*.coverprofile

# Go workspace
go.work
go.work.sum

# Real captured skins. testdata/captures/ holds skins logged through the proxy,
# including identity-embedded folder names (testdata/captures/THE_BOSS9345-...)
# and the maintainer's own invisible/tiny skin fixtures at the testdata root.
# Committing them leaks real player data and violates the project's "no real
# skins in the repo" rule, so they stay local. The detection tests reference
# them but skip when absent (CI has no testdata), so a maintainer can copy the
# real captures in locally for full cross-validation.
testdata/captures/
testdata/invisible-skin-*.png
testdata/invisible-skin-*-geometry.json
testdata/tiny-skin.png
testdata/tiny-skin-geometry.json

# Exceptions.
#
# testdata/bench-skin/ is a scrubbed vanilla 3D humanoid (real geometry + skin
# texture, no identity fields, no clientdata/resource pack) committed purely as
# a render benchmark fixture.
#
# testdata/golden/ holds the pixel-regression fixtures. They are rendered from
# the procedural test texture, not a real skin, so no third-party artwork is
# involved. Regenerate with: go test -run TestGoldenRenders -update
!testdata/
testdata/*
!testdata/bench-skin/
!testdata/bench-skin/*
!testdata/golden/
!testdata/golden/*

# Failing inputs go's fuzzer minimizes are meant to be committed as
# regression seeds - they are tiny and they are the bug.
!testdata/fuzz/
!testdata/fuzz/**

# Editor
.idea/
.vscode/
.DS_Store
